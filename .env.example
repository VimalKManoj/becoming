# Copy to .env.local; run npm run backend to link your own development project.
# Never copy credentials from the portfolio app.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Convex dashboard environment only: SITE_URL and BETTER_AUTH_SECRET.
# See documents/AUTH_SETUP.md. Never prefix secrets with NEXT_PUBLIC_.
